APP_NAME=Report Agent Backend
ENVIRONMENT=development
# 网关按 /api/<服务>/v1/* 把请求分发到各自的容器，别的团队的工具挂在同一个 /api 下。
# 改这个值要同步改前端的 HOST_NAMESPACE 和 nginx 的 location。
API_PREFIX=/api/report/v1
DATABASE_URL=

# 登录校验读的用户库，需含 users 表（id/username/password/role/workspace）
AUTH_DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/AI_DA_DB?charset=utf8mb4
# 签发 token 的密钥，正式环境必须配置；留空则每次启动随机生成，重启即掉登录态
AUTH_SECRET=
AUTH_TOKEN_TTL_SECONDS=43200

LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL_NAME=deepseek-v4-flash-0731
# 所有需要持久化的东西都挂在 STATE_DIR 下：上传的文件、生成的报告、
# 报告与对话状态、已保存的数据源连接。容器只需挂载这一个卷。
# 留空时本地开发落在 $TMPDIR/report-agent。
# STATE_DIR=/var/lib/report-agent

# 下面三项默认由 STATE_DIR 派生，通常不需要单独设置。
# DATA_DIR / ARTIFACT_DIR / LOG_DIR 填 ./data、./artifacts、./logs 会被忽略——
# 那些目录在项目树内，uvicorn --reload 会因为写入而重启进程。
# DATA_DIR=
# ARTIFACT_DIR=
# LOG_DIR=

# 容器里必须绑 0.0.0.0，否则外部访问不到。
# HOST=0.0.0.0
# PORT=8000
