# 复制到仓库根目录的 .env，docker compose 会自动读取。
#
#   cp deploy/env.example .env
#
# 这个文件里会有密钥，别提交进仓库（根目录 .gitignore 已经忽略 .env）。

# ── 镜像与端口 ────────────────────────────────────────────────────────
IMAGE_TAG=latest
GATEWAY_PORT=80

# ── 登录 ──────────────────────────────────────────────────────────────
# 工作台内所有后端（包括其他团队的）必须用同一个值，HS256。
# 生成方式：openssl rand -base64 48
# 换这个值会让所有已登录用户掉线，要挑个时间窗口。
AUTH_SECRET=

# 用户库，需含 users 表（id/username/password/role/workspace）。
# 密码里的 @ 要写成 %40，否则会被当成 host 分隔符解析。
AUTH_DATABASE_URL=mysql+pymysql://user:password@10.0.0.10:3306/AI_DA_DB?charset=utf8mb4

# 登录态有效期，秒。默认 12 小时。
AUTH_TOKEN_TTL_SECONDS=43200

# ── 内网 LLM 网关（OpenAI 兼容）────────────────────────────────────────
LLM_BASE_URL=http://10.0.0.20:8000/v1
LLM_API_KEY=
LLM_MODEL_NAME=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=5

# ── openLooKeng（用不到就忽略，并把 compose 里那个挂载删掉）───────────
# JRE 已经装在后端镜像里（openjdk-17-jre-headless），这里不用配。
# 只需要指定放 JDBC 驱动 jar 的宿主机目录，会挂到容器的 /opt/jdbc。
#
# 把 hetu-jdbc 的 jar 放进这个目录就行，服务会自己找，不用对齐文件名，
# 前端表单里也**不再需要填 jar 路径**（它是部署产物，不是用户输入）。
JDBC_JAR_DIR_HOST=./deploy/jdbc

# 服务端报 "Authentication requires SSL" 时设为 true。
HETU_JDBC_SSL=false

# ── 日志 ──────────────────────────────────────────────────────────────
# DEBUG 会额外打印每个指标的完整取数对话，排查数字不对时有用，但很吵。
LOG_LEVEL=INFO
